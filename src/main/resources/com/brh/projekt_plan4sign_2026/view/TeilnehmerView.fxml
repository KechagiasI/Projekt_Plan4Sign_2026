<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.brh.projekt_plan4sign_2026.controller.TeilnehmerController"
      alignment="CENTER"
      spacing="20"
      prefWidth="800"
      prefHeight="600">

    <Label text="Teilnehmer – Stundenplan"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <!-- Begrüßungstext – wird vom Controller befüllt -->
    <Label fx:id="labelWillkommen"
           style="-fx-font-size: 14px; -fx-text-fill: #444;"/>

    <!-- Tabelle mit dem Stundenplan der eigenen Klasse -->
    <TableView fx:id="tableUnterricht" prefHeight="400">
        <columns>
            <TableColumn fx:id="colDate"        text="Datum"        prefWidth="110"/>
            <TableColumn fx:id="colStart"       text="Start"        prefWidth="80"/>
            <TableColumn fx:id="colEnd"         text="Ende"         prefWidth="80"/>
            <TableColumn fx:id="colFach"        text="Fach"         prefWidth="200"/>
            <TableColumn fx:id="colDolmetscher" text="Dolmetscher"  prefWidth="220"/>
        </columns>
    </TableView>

</VBox>