<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.brh.projekt_plan4sign_2026.controller.LoginController"
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="350"
      style="-fx-background-color: #f4f4f4;"
      focusTraversable="true">


    <padding>
        <Insets top="60" right="80" bottom="60" left="80"/>
    </padding>

    <!-- Titel -->
    <Label text="Plan4Sign – Login"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- Benutzername -->
    <TextField fx:id="usernameField"
               promptText="Benutzername"
               prefWidth="280"/>

    <!-- Passwort -->
    <PasswordField fx:id="passwordField"
                   promptText="Passwort"
                   prefWidth="280"/>

    <!-- Fehlermeldung -->
    <Label fx:id="errorLabel"
           style="-fx-text-fill: red; -fx-font-size: 12px;"
           text=""/>

    <!-- Login-Button -->
    <Button text="Anmelden"
            onAction="#handleLogin"
            prefWidth="280"
            style="-fx-background-color: #2c6fad; -fx-text-fill: white; -fx-font-size: 14px;"/>


</VBox>