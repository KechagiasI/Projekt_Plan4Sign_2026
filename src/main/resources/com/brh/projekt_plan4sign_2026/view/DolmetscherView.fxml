<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    DolmetscherView.fxml
    Ansicht für die Rolle: DOLMETSCHER
    Verknüpft mit: DolmetscherController.java
-->

<!-- Hauptlayout: vertikale Anordnung aller Elemente -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.brh.projekt_plan4sign_2026.controller.DolmetscherController"
      alignment="CENTER"
      spacing="20"
      prefWidth="800"
      prefHeight="600"
      VBox.vgrow="ALWAYS">

    <!-- Innenabstand: Abstand vom Fensterrand -->
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <!-- Titelzeile -->
    <Label text="Dolmetscher – Einsatzplan"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <!-- Begrüßungstext: wird vom Controller dynamisch befüllt -->
    <!-- z.B. "Willkommen, Evridiki Dermetzidou" -->
    <Label fx:id="labelWillkommen"
           style="-fx-font-size: 14px; -fx-text-fill: #444;"/>

    <!-- Tabelle: zeigt nur die eigenen Unterrichtseinheiten des Dolmetschers -->
    <!-- Daten werden gefiltert nach DolmetscherID (Dependency Injection) -->
    <TableView fx:id="tableUnterricht"
               VBox.vgrow="ALWAYS">
        <columns>
            <!-- Spalten werden im Controller mit Daten befüllt -->
            <TableColumn fx:id="colDate"       text="Datum"      prefWidth="110"/>
            <TableColumn fx:id="colStart"      text="Start"      prefWidth="80"/>
            <TableColumn fx:id="colEnd"        text="Ende"       prefWidth="80"/>
            <TableColumn fx:id="colKlasse"     text="Klasse"     prefWidth="100"/>
            <TableColumn fx:id="colFach"       text="Fach"       prefWidth="160"/>
            <TableColumn fx:id="colTeilnehmer" text="Teilnehmer" prefWidth="170"/>
        </columns>
    </TableView>

    <!-- Abmelden: ruft handleLogout() auf → zurück zur LoginView -->
    <Button text="Abmelden" onAction="#handleLogout"/>

</VBox>